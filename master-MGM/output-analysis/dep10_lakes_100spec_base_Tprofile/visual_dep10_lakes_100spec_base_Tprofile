# --- size: Areagroup 
# get Areakm2
lake_area <- func_getAreaKm2(lake_path)

lake_Agroup <- sapply(lake_area$areakm2, func_getAreaGroup)

res$lakeGroup_Area <- NA
env$lakeGroup_Area <- NA

