    ) %>% ungroup()  %>%
    mutate(lakeGroup_Area = factor(lakeGroup_Area,
                                 levels = c("very.small", "small", "medium", "large", "very.large")))
head(sort_env)
nrow(sort_env)

unique(sort_env$day)
save(sort_env, file = file.path(save_figures, "sortENV_dep10_Tprofile.RData"))
